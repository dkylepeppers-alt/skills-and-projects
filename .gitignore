# Credentials and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Installed dependencies and caches
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
Thumbs.db
*.log

# Generated working outputs; releases remain tracked
**/build/
projects/nevermore/source/map.json
projects/nevermore/checks/*-results.json

# Scratch and transfer archives
.tmp/
*.zip
*.tar.gz

# Gallery Illustrator extension ZIP in its release (verified by SHA256SUMS)
!projects/gallery-illustrator/releases/*/gallery-reference-pool.personal-extension.zip

# Immutable nativity workshop release packages (verified by SHA256SUMS)
!projects/nativity-barn/releases/*/nativity-workshop-*.zip
