diff --git a/packages/server/src/services/image/gallery-reference-pool.ts b/packages/server/src/services/image/gallery-reference-pool.ts
new file mode 100644
index 000000000..076690dda
--- /dev/null
+++ b/packages/server/src/services/image/gallery-reference-pool.ts
@@ -0,0 +1,359 @@
+/**
+ * Local patch (gallery-reference-pool): a custom image agent may name the gallery pictures it wants as
+ * reference images, by role, instead of the automatic one-picture-per-character selection. Edit models such as
+ * Seedream take up to ten references and keep identity best with a face close-up plus body, outfit and location
+ * pictures, which the automatic selection cannot provide.
+ *
+ * The agent's `image_prompt` result carries `references: [{ id, role, subject? }]`. Ids are prefixed by gallery:
+ *   cg:<id>  a character gallery image   (the character must be in this chat's cast)
+ *   pg:<id>  a persona gallery image     (the persona must be this chat's persona)
+ *   gg:<id>  a Global Gallery image
+ *   ch:<id>  this chat's own gallery image
+ * Unknown, malformed, missing or out-of-scope ids are skipped. When none survive, the caller keeps the
+ * automatic selection.
+ */
+import { readFile } from "node:fs/promises";
+import { extname } from "node:path";
+import type { DB } from "../../db/connection.js";
+import { logger } from "../../lib/logger.js";
+import { isAllowedImageBuffer } from "../../utils/security.js";
+import { createCharacterGalleryStorage } from "../storage/character-gallery.storage.js";
+import { createGalleryStorage } from "../storage/gallery.storage.js";
+import { createGlobalGalleryStorage } from "../storage/global-gallery.storage.js";
+import { createPersonaGalleryStorage } from "../storage/persona-gallery.storage.js";
+import { resolveStoredGalleryFile } from "./gallery-file-lifecycle.js";
+import { resolveGalleryImagePath } from "./gallery-image-path.js";
+
+export const POOL_MAX_REFERENCES = 10;
+
+export const POOL_REFERENCE_ROLES = [
+  "face",
+  "body",
+  "outfit",
+  "expression",
+  "location",
+  "prop",
+  "style",
+  "other",
+] as const;
+export type PoolReferenceRole = (typeof POOL_REFERENCE_ROLES)[number];
+
+const ROLE_RANK: Record<PoolReferenceRole, number> = {
+  face: 0,
+  expression: 1,
+  body: 2,
+  outfit: 3,
+  location: 4,
+  prop: 5,
+  style: 6,
+  other: 7,
+};
+
+const POOL_ID = /^(cg|pg|gg|ch):([A-Za-z0-9_-]{1,64})$/;
+
+export type PoolReferenceKind = "cg" | "pg" | "gg" | "ch";
+
+export type PoolReferenceRequest = {
+  /** The prefixed id as the agent wrote it, e.g. `cg:abc123`. */
+  id: string;
+  kind: PoolReferenceKind;
+  imageId: string;
+  role: PoolReferenceRole;
+  /** The agent's own label; used only for Global Gallery and chat images, which have no owner. */
+  subject: string | null;
+};
+
+function cleanSubject(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const cleaned = value
+    .replace(/[\u0000-\u001f\u007f]+/g, " ")
+    .replace(/\s+/g, " ")
+    .trim()
+    .slice(0, 60);
+  return cleaned || null;
+}
+
+function readRole(value: unknown): PoolReferenceRole {
+  const role = typeof value === "string" ? value.trim().toLowerCase() : "";
+  return (POOL_REFERENCE_ROLES as readonly string[]).includes(role) ? (role as PoolReferenceRole) : "other";
+}
+
+/**
+ * Read the agent's `references` list: valid entries only, de-duplicated by id, faces first and the rest by role
+ * (the agent's order is kept within a role), capped. Providers drop trailing references when they must, so the
+ * least important go first.
+ */
+export function parsePoolReferences(value: unknown, maximum = POOL_MAX_REFERENCES): PoolReferenceRequest[] {
+  if (!Array.isArray(value)) return [];
+  const seen = new Set<string>();
+  const parsed: Array<PoolReferenceRequest & { order: number }> = [];
+  value.forEach((entry, order) => {
+    if (!entry || typeof entry !== "object" || Array.isArray(entry)) return;
+    const record = entry as Record<string, unknown>;
+    const id = typeof record.id === "string" ? record.id.trim() : "";
+    const match = POOL_ID.exec(id);
+    if (!match || seen.has(id)) return;
+    seen.add(id);
+    parsed.push({
+      id,
+      kind: match[1] as PoolReferenceKind,
+      imageId: match[2]!,
+      role: readRole(record.role),
+      subject: cleanSubject(record.subject),
+      order,
+    });
+  });
+  return parsed
+    .sort((a, b) => ROLE_RANK[a.role] - ROLE_RANK[b.role] || a.order - b.order)
+    .slice(0, Math.max(0, Math.min(maximum, POOL_MAX_REFERENCES)))
+    .map(({ order: _order, ...request }) => request);
+}
+
+const PERSON_ROLES = new Set<PoolReferenceRole>(["face", "expression", "body", "outfit", "other"]);
+
+/** "A", "B", … "Z", "AA" — people are named by letter because image models do not know character names. */
+export function personLetter(index: number): string {
+  let letter = "";
+  let n = index;
+  do {
+    letter = String.fromCharCode(65 + (n % 26)) + letter;
+    n = Math.floor(n / 26) - 1;
+  } while (n >= 0);
+  return letter;
+}
+
+/** How the prompt names one reference: "person A's face", "the location", "the art style guide". */
+export function poolReferenceLabel(role: PoolReferenceRole, person: string | null): string {
+  const who = person ? `person ${person}'s` : null;
+  switch (role) {
+    case "face":
+      return who ? `${who} face` : "a face reference";
+    case "expression":
+      return who ? `${who} expression` : "an expression reference";
+    case "body":
+      return who ? `${who} full body` : "a full-body reference";
+    case "outfit":
+      return who ? `${who} outfit` : "an outfit reference";
+    case "location":
+      return "the location";
+    case "prop":
+      return "a prop";
+    case "style":
+      return "the art style guide";
+    default:
+      return person ? `another picture of person ${person}` : "an extra reference";
+  }
+}
+
+/** Number every reference by position so edit models pair each person with that person's own pictures. */
+export function poolReferenceOrderLine(labels: readonly string[]): string {
+  if (labels.length === 0) return "";
+  const order = labels.map((label, index) => `image ${index + 1} is ${label}`).join("; ");
+  return `Reference image order: ${order}. Keep each person's identity from that person's own face, expression, body and outfit references and never mix features between people; take the setting from the location reference and the rendering from the art style guide. The written prompt decides composition, action, framing and mood.`;
+}
+
+export type PoolReferenceScope = {
+  chatId: string;
+  /** Characters whose gallery images may be used; null allows any (a stored record being replayed). */
+  characters: ReadonlyMap<string, string> | null;
+  /** Personas whose gallery images may be used; null allows any. */
+  personas: ReadonlyMap<string, string> | null;
+};
+
+export type PoolReferenceStores = {
+  characterGallery: { getById: (id: string) => Promise<{ characterId: string; filePath: string } | null> };
+  personaGallery: { getById: (id: string) => Promise<{ personaId: string; filePath: string } | null> };
+  chatGallery: { getById: (id: string) => Promise<{ chatId: string; filePath: string } | null> };
+  globalGallery: { getImageById: (id: string) => Promise<{ filePath: string } | null> };
+  readOwnerName?: (kind: "cg" | "pg", ownerId: string) => Promise<string | null>;
+  readFile?: (path: string) => Promise<Buffer>;
+};
+
+export function createPoolReferenceStores(db: DB): PoolReferenceStores {
+  return {
+    characterGallery: createCharacterGalleryStorage(db),
+    personaGallery: createPersonaGalleryStorage(db),
+    chatGallery: createGalleryStorage(db),
+    globalGallery: createGlobalGalleryStorage(db),
+  };
+}
+
+export type PoolReferenceResolution = {
+  /** Base64 image data in send order. */
+  images: string[];
+  /** Prefixed ids actually sent, in send order. */
+  ids: string[];
+  /** `role|id|subject` for each sent reference, stored in the generation record so Regenerate reuses them. */
+  recorded: string[];
+  /** Prompt labels: "person A's face", "the location". */
+  labels: string[];
+  /** Log-only descriptions with owner names: "face of Mara (person A)". */
+  named: string[];
+  orderLine: string;
+};
+
+async function readImageFile(absolutePath: string, stores: PoolReferenceStores): Promise<string | null> {
+  const buffer = await (stores.readFile ?? readFile)(absolutePath);
+  if (!isAllowedImageBuffer(buffer, extname(absolutePath))) return null;
+  return buffer.toString("base64");
+}
+
+async function loadPoolReference(
+  request: PoolReferenceRequest,
+  scope: PoolReferenceScope,
+  stores: PoolReferenceStores,
+): Promise<{ base64: string; ownerKey: string | null; ownerName: string | null } | null> {
+  switch (request.kind) {
+    case "cg": {
+      const image = await stores.characterGallery.getById(request.imageId);
+      if (!image) return null;
+      if (scope.characters && !scope.characters.has(image.characterId)) return null;
+      const stored = resolveStoredGalleryFile(image.filePath);
+      if (!stored) return null;
+      const base64 = await readImageFile(stored.absolutePath, stores);
+      const ownerName =
+        scope.characters?.get(image.characterId) ??
+        (await stores.readOwnerName?.("cg", image.characterId)) ??
+        request.subject;
+      return base64 ? { base64, ownerKey: `character:${image.characterId}`, ownerName } : null;
+    }
+    case "pg": {
+      const image = await stores.personaGallery.getById(request.imageId);
+      if (!image) return null;
+      if (scope.personas && !scope.personas.has(image.personaId)) return null;
+      const stored = resolveStoredGalleryFile(image.filePath);
+      if (!stored) return null;
+      const base64 = await readImageFile(stored.absolutePath, stores);
+      const ownerName =
+        scope.personas?.get(image.personaId) ??
+        (await stores.readOwnerName?.("pg", image.personaId)) ??
+        request.subject;
+      return base64 ? { base64, ownerKey: `persona:${image.personaId}`, ownerName } : null;
+    }
+    case "ch": {
+      const image = await stores.chatGallery.getById(request.imageId);
+      if (!image || image.chatId !== scope.chatId) return null;
+      const path = resolveGalleryImagePath(image);
+      if (!path) return null;
+      const base64 = await readImageFile(path, stores);
+      return base64 ? { base64, ...unownedSubject(request) } : null;
+    }
+    case "gg": {
+      const image = await stores.globalGallery.getImageById(request.imageId);
+      if (!image) return null;
+      const path = resolveGalleryImagePath({ chatId: "global", filePath: image.filePath });
+      if (!path) return null;
+      const base64 = await readImageFile(path, stores);
+      return base64 ? { base64, ...unownedSubject(request) } : null;
+    }
+  }
+}
+
+/** A chat or Global Gallery picture has no owner record; the agent's subject text groups a person's pictures. */
+function unownedSubject(request: PoolReferenceRequest): { ownerKey: string | null; ownerName: string | null } {
+  const key = request.subject?.toLowerCase();
+  return { ownerKey: key ? `subject:${key}` : null, ownerName: request.subject };
+}
+
+/**
+ * Load the requested pool references. Returns null when the list is absent or nothing in it can be used, so the
+ * caller keeps the automatic selection.
+ */
+export async function resolvePoolReferences(args: {
+  references: unknown;
+  scope: PoolReferenceScope;
+  stores: PoolReferenceStores;
+  maximum?: number;
+}): Promise<PoolReferenceResolution | null> {
+  const requests = parsePoolReferences(args.references, args.maximum);
+  if (requests.length === 0) return null;
+  const images: string[] = [];
+  const ids: string[] = [];
+  const labels: string[] = [];
+  const named: string[] = [];
+  const sent: PoolReferenceRequest[] = [];
+  const letters = new Map<string, string>();
+  for (const request of requests) {
+    try {
+      const loaded = await loadPoolReference(request, args.scope, args.stores);
+      if (!loaded) {
+        logger.debug("[gallery-reference-pool] Skipped %s: missing, unreadable or outside this chat", request.id);
+        continue;
+      }
+      images.push(loaded.base64);
+      ids.push(request.id);
+      sent.push(request);
+      // Letters follow the send order, so faces (sent first) fix who is person A, B, …
+      let person: string | null = null;
+      if (PERSON_ROLES.has(request.role) && loaded.ownerKey) {
+        person = letters.get(loaded.ownerKey) ?? personLetter(letters.size);
+        letters.set(loaded.ownerKey, person);
+      }
+      labels.push(poolReferenceLabel(request.role, person));
+      named.push(
+        `${request.role}${loaded.ownerName ? ` of ${loaded.ownerName}` : ""}${person ? ` (person ${person})` : ""}`,
+      );
+    } catch (err) {
+      logger.warn(err, "[gallery-reference-pool] Could not read %s", request.id);
+    }
+  }
+  if (images.length === 0) return null;
+  return {
+    images,
+    ids,
+    recorded: encodeRecordedPoolReferences(sent),
+    labels,
+    named,
+    orderLine: poolReferenceOrderLine(labels),
+  };
+}
+
+/** Rebuild a role/subject request list from recorded ids (`<role>|<id>|<subject>`), for Regenerate. */
+export function encodeRecordedPoolReferences(
+  requests: ReadonlyArray<{ id: string; role: PoolReferenceRole; subject?: string | null }>,
+): string[] {
+  return requests.map((request) => [request.role, request.id, request.subject ?? ""].join("|"));
+}
+
+export function decodeRecordedPoolReferences(values: readonly string[] | undefined): Array<Record<string, string>> {
+  return (values ?? []).flatMap((value) => {
+    const [role, id, ...subject] = value.split("|");
+    return role && id ? [{ role, id, subject: subject.join("|") }] : [];
+  });
+}
+
+/** Character id → name and persona id → name maps for the chat cast, from the illustrator cast lists. */
+export function poolScopeFromCast(
+  chatId: string,
+  cast: {
+    chatCharacters: ReadonlyArray<{ id: string; name: string }>;
+    persona?: { id: string | null; name: string } | null;
+  },
+): PoolReferenceScope {
+  return {
+    chatId,
+    characters: new Map(cast.chatCharacters.map((character) => [character.id, character.name])),
+    personas: new Map(cast.persona?.id ? [[cast.persona.id, cast.persona.name]] : []),
+  };
+}
+
+/** Owner names for a replayed record, read from the character and persona stores. */
+export function poolOwnerNameReader(store: {
+  getById: (id: string) => Promise<{ data: unknown } | null>;
+  getPersona: (id: string) => Promise<{ name?: unknown } | null>;
+}): NonNullable<PoolReferenceStores["readOwnerName"]> {
+  return async (kind, ownerId) => {
+    try {
+      if (kind === "pg") {
+        const persona = await store.getPersona(ownerId);
+        return typeof persona?.name === "string" && persona.name.trim() ? persona.name.trim() : null;
+      }
+      const row = await store.getById(ownerId);
+      const data = typeof row?.data === "string" ? JSON.parse(row.data) : row?.data;
+      const name = (data as { name?: unknown } | null | undefined)?.name;
+      return typeof name === "string" && name.trim() ? name.trim() : null;
+    } catch {
+      return null;
+    }
+  };
+}
