diff --git a/scripts/regressions/agents/gallery-reference-pool.regression.ts b/scripts/regressions/agents/gallery-reference-pool.regression.ts
new file mode 100644
index 000000000..20f30717e
--- /dev/null
+++ b/scripts/regressions/agents/gallery-reference-pool.regression.ts
@@ -0,0 +1,175 @@
+// Local patch (gallery-reference-pool): a custom image agent's gallery picks replace the automatic references.
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  buildChatImageGenerationRecord,
+  parseChatImageGenerationRecord,
+} from "../../../packages/shared/src/utils/chat-image-generation.js";
+import type { PoolReferenceStores } from "../../../packages/server/src/services/image/gallery-reference-pool.js";
+// Gallery files resolve under DATA_DIR, so point it at a scratch folder before the module loads.
+const dataDir = mkdtempSync(join(tmpdir(), "gallery-reference-pool-"));
+process.env.DATA_DIR = dataDir;
+const {
+  decodeRecordedPoolReferences,
+  parsePoolReferences,
+  personLetter,
+  poolReferenceLabel,
+  poolReferenceOrderLine,
+  poolScopeFromCast,
+  resolvePoolReferences,
+} = await import("../../../packages/server/src/services/image/gallery-reference-pool.js");
+
+// Parsing: valid prefixed ids only, de-duplicated, faces first, capped at ten.
+const parsed = parsePoolReferences([
+  { id: "gg:room1", role: "location" },
+  { id: "cg:maraBody", role: "body", subject: "Mara" },
+  { id: "cg:maraFace", role: "face", subject: "Mara" },
+  { id: "cg:maraFace", role: "face" },
+  { id: "xx:bad", role: "face" },
+  { id: "cg:../../etc/passwd", role: "face" },
+  { id: "pg:meFace", role: "FACE" },
+  { id: "ch:style1", role: "unknown-role" },
+  "not an object",
+]);
+assert.deepEqual(
+  parsed.map((entry) => [entry.id, entry.role]),
+  [
+    ["cg:maraFace", "face"],
+    ["pg:meFace", "face"],
+    ["cg:maraBody", "body"],
+    ["gg:room1", "location"],
+    ["ch:style1", "other"],
+  ],
+);
+assert.equal(
+  parsePoolReferences(Array.from({ length: 14 }, (_, index) => ({ id: `gg:img${index}`, role: "prop" }))).length,
+  10,
+);
+assert.deepEqual(parsePoolReferences(undefined), []);
+assert.deepEqual(parsePoolReferences([{ id: "gg:x", role: "face" }], 0), []);
+
+// Labels name people by letter (image models do not know character names), and the order line numbers them.
+assert.equal(poolReferenceLabel("face", "A"), "person A's face");
+assert.equal(poolReferenceLabel("body", null), "a full-body reference");
+assert.equal(poolReferenceLabel("location", "A"), "the location");
+assert.equal(poolReferenceLabel("style", "B"), "the art style guide");
+assert.deepEqual([0, 1, 25, 26, 27].map(personLetter), ["A", "B", "Z", "AA", "AB"]);
+assert.match(
+  poolReferenceOrderLine(["person A's face", "the location"]),
+  /^Reference image order: image 1 is person A's face; image 2 is the location\./,
+);
+assert.equal(poolReferenceOrderLine([]), "");
+
+// Loading: ownership is checked against the chat cast; unreadable or foreign images are skipped.
+const png = Buffer.from(
+  "89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c4890000000d4944415478da63f8ffff3f0005fe02fea7d6a8f20000000049454e44ae426082",
+  "hex",
+);
+const stores: PoolReferenceStores = {
+  characterGallery: {
+    getById: async (id) =>
+      ({
+        maraFace: { characterId: "mara", filePath: "characters/mara/face.png" },
+        maraBody: { characterId: "mara", filePath: "characters/mara/body.png" },
+        strangerFace: { characterId: "stranger", filePath: "characters/stranger/face.png" },
+        notImage: { characterId: "mara", filePath: "characters/mara/notes.png" },
+      })[id] ?? null,
+  },
+  personaGallery: {
+    getById: async (id) => (id === "meFace" ? { personaId: "me", filePath: "personas/me/face.png" } : null),
+  },
+  chatGallery: { getById: async (id) => (id === "otherChat" ? { chatId: "chat-2", filePath: "chat-2/x.png" } : null) },
+  globalGallery: { getImageById: async () => null },
+  readFile: async (path) => (path.endsWith("notes.png") ? Buffer.from("plain text") : png),
+};
+const scope = poolScopeFromCast("chat-1", {
+  chatCharacters: [{ id: "mara", name: "Mara" }],
+  persona: { id: "me", name: "Quinn" },
+});
+const resolved = await resolvePoolReferences({
+  references: [
+    { id: "cg:maraBody", role: "body" },
+    { id: "cg:strangerFace", role: "face" },
+    { id: "cg:notImage", role: "outfit" },
+    { id: "ch:otherChat", role: "location" },
+    { id: "gg:missing", role: "location" },
+    { id: "pg:meFace", role: "face", subject: "Someone Else" },
+    { id: "cg:maraFace", role: "face", subject: "Wrong Name" },
+  ],
+  scope,
+  stores,
+});
+assert.ok(resolved);
+assert.deepEqual(resolved.ids, ["pg:meFace", "cg:maraFace", "cg:maraBody"]);
+// Owners come from the cast, not the agent's subject text: Mara's face and body share one letter.
+assert.deepEqual(resolved.labels, ["person A's face", "person B's face", "person B's full body"]);
+assert.deepEqual(resolved.named, ["face of Quinn (person A)", "face of Mara (person B)", "body of Mara (person B)"]);
+assert.doesNotMatch(resolved.orderLine, /Mara|Quinn|Wrong Name|Someone Else/, "names never reach the image model");
+assert.equal(resolved.images.length, 3);
+assert.equal(resolved.images[0], png.toString("base64"));
+assert.match(
+  resolved.orderLine,
+  /image 1 is person A's face; image 2 is person B's face; image 3 is person B's full body/,
+);
+assert.equal(
+  await resolvePoolReferences({ references: [{ id: "cg:strangerFace", role: "face" }], scope, stores }),
+  null,
+  "nothing usable keeps the automatic selection",
+);
+assert.equal(await resolvePoolReferences({ references: undefined, scope, stores }), null);
+
+mkdirSync(join(dataDir, "gallery", "global"), { recursive: true });
+for (const name of ["faceX", "bodyX", "room"]) writeFileSync(join(dataDir, "gallery", "global", `${name}.png`), png);
+
+// Chat and Global Gallery pictures have no owner; the agent's subject text groups them into one person.
+const unowned = await resolvePoolReferences({
+  references: [
+    { id: "gg:faceX", role: "face", subject: "Stranger" },
+    { id: "gg:bodyX", role: "body", subject: "stranger" },
+    { id: "gg:room", role: "location", subject: "Harbor" },
+  ],
+  scope,
+  stores: {
+    ...stores,
+    globalGallery: { getImageById: async (id) => ({ filePath: `${id}.png` }) },
+  },
+});
+assert.ok(unowned);
+assert.deepEqual(unowned.labels, ["person A's face", "person A's full body", "the location"]);
+
+// The record keeps the picks, and Regenerate decodes them back into the same request list.
+const record = parseChatImageGenerationRecord(
+  JSON.stringify(buildChatImageGenerationRecord({ prompt: "p", poolReferences: resolved.recorded })),
+);
+assert.deepEqual(record?.references.poolReferences, [
+  "face|pg:meFace|Someone Else",
+  "face|cg:maraFace|Wrong Name",
+  "body|cg:maraBody|",
+]);
+assert.deepEqual(
+  parsePoolReferences(decodeRecordedPoolReferences(record?.references.poolReferences)).map((entry) => entry.id),
+  resolved.ids,
+);
+assert.equal(buildChatImageGenerationRecord({ prompt: "p" }).references.poolReferences, undefined);
+
+// Both illustrator routes and Regenerate dispatch the pool, and only for custom agents.
+for (const route of ["generate.routes.ts", "generate/retry-agents-route.ts"]) {
+  const source = readFileSync(new URL(`../../../packages/server/src/routes/${route}`, import.meta.url), "utf8");
+  assert.match(
+    source,
+    /!usesChatIllustratorSettings && imageModelGetsReferences\s*\?\s*await resolvePoolReferences\(/,
+    route,
+  );
+  assert.match(source, /includeReferenceImages: useAvatarRefs && !poolReferences/, route);
+  assert.match(source, /poolReferences: poolReferences\?\.recorded/, route);
+}
+const gallerySource = readFileSync(
+  new URL("../../../packages/server/src/routes/gallery.routes.ts", import.meta.url),
+  "utf8",
+);
+assert.match(gallerySource, /decodeRecordedPoolReferences\(references\.poolReferences\)/);
+
+rmSync(dataDir, { recursive: true, force: true });
+console.log("gallery-reference-pool regression passed");
