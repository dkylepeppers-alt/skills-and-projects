index 0000000..b1251c5
--- /dev/null
+++ b/packages/server/src/services/agents/gallery-prompt-pool.ts
@@ -0,0 +1,53 @@
+import type { AgentContext } from "@marinara-engine/shared";
+
+const START = "<!-- reference-pool:start -->";
+const END = "<!-- reference-pool:end -->";
+const MAX_ROWS = 120;
+
+/** The synced roster is shared. Select the rows for this turn before the template reaches the model. */
+export function scopeGalleryPrompt(
+  template: string,
+  context: Pick<AgentContext, "characters" | "persona" | "chatId" | "memory">,
+): string {
+  const start = template.indexOf(START);
+  if (start < 0) return template;
+  const bodyStart = start + START.length;
+  const end = template.indexOf(END, bodyStart);
+  if (end < 0) return template;
+
+  const characters = new Map(context.characters.map(({ id, name }) => [id, name]));
+  const identity = context.memory._userIdentityId;
+  const characterIdentity = context.memory._userIdentitySource === "character";
+  if (characterIdentity && typeof identity === "string" && context.persona)
+    characters.set(identity, context.persona.name);
+  const personaId = characterIdentity ? null : (context.memory._personaId ?? identity);
+  const characterNames = new Set(Array.from(characters.values(), (name) => name.trim().toLowerCase()));
+  const personaName = context.persona?.name.trim().toLowerCase();
+  const faces = new Map<string, string>();
+  const castRows: string[] = [];
+  const remaining: string[] = [];
+  for (const line of template.slice(bodyStart, end).trim().split("\n")) {
+    const [id, owner, role, caption, source] = line.split(" | ");
+    if (!id || !owner || !role || !caption) continue;
+    const kind = id.slice(0, id.indexOf(":"));
+    const name = owner.toLowerCase();
+    if (kind === "cg" && !(source ? characters.has(source) : characterNames.has(name))) continue;
+    if (kind === "pg" && !(source ? source === personaId : !characterIdentity && name === personaName)) continue;
+    if (kind === "ch" && source !== context.chatId) continue;
+    if (!["cg", "pg", "gg", "ch"].includes(kind)) continue;
+    const personInCast = kind === "cg" || kind === "pg" || characterNames.has(name) || name === personaName;
+    // Reserve distinct card faces even when the cards have identical display names.
+    const key = source && (kind === "cg" || kind === "pg") ? kind + ":" + source : name;
+    if (role === "face" && personInCast && !faces.has(key)) faces.set(key, line);
+    else if (personInCast) castRows.push(line);
+    else remaining.push(line);
+  }
+  const rows = [...faces.values(), ...castRows, ...remaining].slice(0, MAX_ROWS);
+  return (
+    template.slice(0, bodyStart) +
+    "\n" +
+    (rows.join("\n") || "(No matching references for this chat.)") +
+    "\n" +
+    template.slice(end)
+  );
+}
