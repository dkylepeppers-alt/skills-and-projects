+/** A partial replay would change every Image N annotation after the missing picture. */
+export function poolReplayError(recorded: readonly string[], actual: readonly string[]): string | null {
+  const expected = decodeRecordedPoolReferences(recorded).map((row) => row.id!);
+  if (
+    expected.length === recorded.length &&
+    expected.length === actual.length &&
+    expected.every((id, i) => id === actual[i])
+  )
+    return null;
+  const missing = expected.filter((id) => !actual.includes(id));
+  return (
+    "Cannot regenerate with the original reference order. " +
+    (missing.length ? "Unavailable references: " + missing.join(", ") : "The recorded reference list has changed.")
+  );
